{
  "name": "nexoffice-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "NexOffice \u2014 Electron desktop office suite",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "bun run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "check:i18n": "node scripts/check-i18n.mjs",
    "pack": "bun run build && electron-builder --dir --publish never",
    "dist": "bun run build && electron-builder --publish never",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:win": "bun run build && electron-builder --win --publish never",
    "dist:linux": "bun run build && electron-builder --linux --publish never",
    "icons": "node scripts/gen-icon.mjs",
    "notarize:dmg": "node scripts/notarize-dmg.mjs",
    "deploy": "node scripts/deploy-azure.mjs"
  },
  "devDependencies": {
    "@betteroffice/docx": "workspace:*",
    "@betteroffice/docx-fonts": "workspace:*",
    "@betteroffice/docx-i18n": "workspace:*",
    "@betteroffice/docx-react": "workspace:*",
    "@betteroffice/pptx": "workspace:*",
    "@betteroffice/pptx-i18n": "workspace:*",
    "@betteroffice/pptx-react": "workspace:*",
    "@betteroffice/xlsx": "workspace:*",
    "@betteroffice/xlsx-i18n": "workspace:*",
    "@betteroffice/xlsx-react": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.10.3",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typo-js": "^1.3.2",
    "vite": "^7.1.5"
  }
}
