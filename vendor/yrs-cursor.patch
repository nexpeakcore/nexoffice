+    /// Opens a reusable insertion point at `index`.
+    ///
+    /// Every `insert*` call above walks the block list from the start of the
+    /// text to reach its index, so filling a text with N chunks costs
+    /// 0 + 1 + ... + N block visits. A cursor pays that walk once: each insert
+    /// through it leaves the position immediately after what it wrote, which is
+    /// where the next ascending insert belongs.
+    ///
+    /// The cursor borrows nothing, but it holds raw block pointers into the
+    /// document: it is only valid until the next structural change made by
+    /// anything other than its own `insert_*_at` calls, and only inside the
+    /// transaction it was opened in.
+    fn cursor(&self, txn: &mut TransactionMut, index: u32) -> Option<TextCursor> {
+        let this = BranchPtr::from(self.as_ref());
+        find_position(this, txn, index).map(TextCursor)
+    }
